rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Requires a signed-in session — the app establishes an anonymous one before it
    // touches Firestore (see ensureAnonymousAuth in src/lib/firebase.ts). Anonymous
    // sign-in is open to anyone, so this keeps out unauthenticated traffic but is not
    // a substitute for real per-user auth; move the login to Firebase Auth's
    // email/password provider before this app leaves the demo phase.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Collection-group rule for the Expenses feature's month-totals listener
    // (collectionGroup(db, "expense_entries")). Collection-group queries are
    // authorized separately from the document-path wildcard above.
    match /{path=**}/expense_entries/{entryId} {
      allow read, write: if request.auth != null;
    }
  }
}
