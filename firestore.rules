rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // DEMO ONLY — fully public. Anyone with the site URL (or who reads the
    // client bundle) can read, edit, or delete every record. Tighten this
    // before this app leaves the demo phase, e.g. by requiring
    // `request.auth != null` once anonymous or real Firebase Auth is wired
    // up alongside the existing login form.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
